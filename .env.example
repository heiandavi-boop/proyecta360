# Proyecta360 — environment configuration (copy to .env and adjust)
# All variables are optional; the defaults below match local development.

# Path to the SQLite database file (created automatically on first run).
PROYECTA360_DB=proyecta360.db

# Comma-separated list of allowed CORS origins.
PROYECTA360_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Runtime environment: local | staging | production
PROYECTA360_ENV=local

# Log level: DEBUG | INFO | WARNING | ERROR
PROYECTA360_LOG_LEVEL=INFO

# Load the Spanish demo project into an empty database on startup.
PROYECTA360_SEED_ON_STARTUP=true

# --- Reserved for upcoming phases (leave unset for now) ---
# PostgreSQL connection URL (Fase 5). When set, overrides PROYECTA360_DB.
# PROYECTA360_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/proyecta360
# Secret used to sign JWTs once authentication lands (Fase 4).
# PROYECTA360_SECRET_KEY=change-me
