APP_ENV=local
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Empty DATABASE_URL keeps SQLite local mode.
# Example PostgreSQL:
# DATABASE_URL=postgresql://proyecta360:proyecta360@localhost:5432/proyecta360
DATABASE_URL=

# SQLite fallback when DATABASE_URL is empty.
PROYECTA360_DB=proyecta360.db

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

PROYECTA360_ADMIN_PASSWORD=admin123
PROYECTA360_PM_PASSWORD=demo123
PROYECTA360_READONLY_PASSWORD=consulta123
